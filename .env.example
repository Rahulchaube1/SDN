# AI-Powered SDN Network Guardian - Environment Configuration
GUARDIAN_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_PATH=./backend/database/guardian_sdn.db

# SDN OpenFlow Controller Settings
CONTROLLER_OF_HOST=0.0.0.0
CONTROLLER_OF_PORT=6653
CONTROLLER_POLL_INTERVAL_SEC=2.0

# Detection Thresholds (Rule-Based Engine)
THRESHOLD_PPS=1200.0
THRESHOLD_BPS=1500000.0
THRESHOLD_SYN_RATIO=0.65
THRESHOLD_SOURCE_FLOW_COUNT=35
THRESHOLD_TRAFFIC_SPIKE_ZSCORE=3.0

# Machine Learning Engine Settings
DETECTION_MODE=hybrid
ML_MODEL_TYPE=random_forest
ML_CONFIDENCE_THRESHOLD=0.65

# Automated Threat Mitigation Settings
AUTO_MITIGATION_ENABLED=true
MITIGATION_DEFAULT_ACTION=DROP
MITIGATION_RULE_HARD_TIMEOUT_SEC=60
MITIGATION_RULE_IDLE_TIMEOUT_SEC=30
MITIGATION_RATE_LIMIT_KBPS=512
PROTECTED_INFRASTRUCTURE_IPS=10.0.0.1,10.0.0.2,10.0.0.3,10.0.0.4,10.0.0.100,127.0.0.1
